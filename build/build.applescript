set P to (do shell script "cd \"$(dirname " & quoted form of POSIX path of (path to me) & ")/..\" && pwd") & "/"
set deckFile to POSIX file (P & "exports/talk.key")
set outFolder to POSIX file (P & "exports/talk")
set img0 to POSIX file (P & "assets/eq/algorithm.pdf")
set img1 to POSIX file (P & "assets/eq/lean.pdf")
set img2 to POSIX file (P & "assets/eq/relwork.pdf")
set img3 to POSIX file (P & "assets/eq/schema.pdf")
set img4 to POSIX file (P & "assets/eq/table1-gpt.pdf")
set img5 to POSIX file (P & "assets/eq/table1-same.pdf")
set img6 to POSIX file (P & "assets/fig/autoformalization.pdf")
set img7 to POSIX file (P & "assets/fig/check.pdf")
set img8 to POSIX file (P & "assets/fig/drift_bars.pdf")
set img9 to POSIX file (P & "assets/fig/framework.pdf")
set img10 to POSIX file (P & "assets/fig/nli-tree.pdf")
set img11 to POSIX file (P & "assets/fig/roundtrip.pdf")

on addSlide(doc, layoutName, titleText, subText, bodyText, notesText)
	tell application "Keynote"
		tell doc
			set s to make new slide at end with properties {base layout:slide layout layoutName}
		end tell
		if titleText is not "" then set object text of default title item of s to titleText
		if bodyText is not "" then set object text of default body item of s to bodyText
		if subText is not "" then set object text of shape 1 of s to subText
		if notesText is not "" then set presenter notes of s to notesText
		return s
	end tell
end addSlide

on fitImage(s, fileRef, boxX, boxY, boxW, boxH)
	tell application "Keynote"
		tell s
			set img to make new image with properties {file:fileRef}
		end tell
		set iw to width of img
		set ih to height of img
		if (boxW / iw) < (boxH / ih) then
			set width of img to boxW
		else
			set height of img to boxH
		end if
		set nw to width of img
		set nh to height of img
		set position of img to {boxX + (boxW - nw) / 2, boxY + (boxH - nh) / 2}
		return (nw as integer) & "x" & (nh as integer)
	end tell
end fitImage

on clearImages(s)
	tell application "Keynote"
		set n to count of images of s
		repeat with k from n to 1 by -1
			delete image k of s
		end repeat
	end tell
end clearImages

set diag to ""
tell application "Keynote"
	set doc to open deckFile
	delay 1
end tell
tell application "Keynote"
	set s to slide 1 of doc
	set object text of default title item of s to "Faithful Autoformalization via Roundtrip Verification and Repair"
	set object text of default body item of s to "Daneshvar Amrollahi†, Jerry Lopez‡, Clark Barrett†" & return & "†Stanford University, ‡Independent researcher" & return & "Findings of EMNLP 2026"
	set object text of shape 1 of s to "CENTAUR 2026"
	set presenter notes of s to "Thanks for the introduction. This is joint work with Jerry Lopez and Clark Barrett. The paper appears in the Findings of EMNLP 2026, one of the main natural language processing conferences." & return & "If you remember one sentence from this talk, make it this: we propose a proxy for measuring faithfulness in autoformalization, and it needs no ground truth, that is, no human-written reference formula to compare against."
end tell
set s to my addSlide(doc, "Title & Bullets", "What is faithful autoformalization?", "", "Autoformalization: an LLM translates natural language (e.g., a loan rule/theorem in NL) into a machine-checkable formal representation (an FOL formula, or a Lean theorem)" & return & "Faithful: the formalization captures what the sentence says, nothing lost, nothing added" & return & "Our instance: Texas statutes to FOL.", "An LLM here is a large language model, a learned text generator with no specification, so its output has to be checked. The strip at the bottom is the picture: a sentence goes in, the LLM writes a formula. The formula is well formed and satisfiable. Whether it is faithful, the dashed line, is the question of this talk. The encoding is illustrative." & return & "Autoformalization is the task of using such a model to turn natural language into a formula a tool can check: a statute, a system requirement, a theorem. The appeal to this community is clear. Every solver and prover has a human in front of it writing the formal input, and that human is the bottleneck." & return & "Faithful means the formula says what the sentence says, nothing lost and nothing added. The problem is that an LLM output can parse, type check, be satisfiable, and still be unfaithful, and nothing in the formal pipeline will complain." & return & "In this talk our instance is statutes to first-order logic checked by Z3, but the framework only needs an equivalence check on the target formalism.")
set diag to diag & "slide 2 image " & (my fitImage(s, img6, 95, 690, 1730, 330)) & linefeed
set s to my addSlide(doc, "Title Only", "Most work scores the proof", "Checks of meaning estimate it. Ours is decided by a solver.", "", "Let me place this against the literature. A benchmark here is a fixed set of problems used to score systems." & return & "Proof-assistant benchmarks and provers, miniF2F, ProofNet, LeanDojo, DeepSeek-Prover, score whether the output compiles or the proof closes. Solver-in-the-loop systems like Logic-LM score whether the final answer is right. Spec synthesis systems like nl2spec and Clover check agreement with code, or leave the reading to a human. In all of these, a wrong formula with a finished proof counts as success." & return & "A line of work checks whether the formula keeps the meaning, under several names. Li et al. 2024 call it semantic consistency: they ask the LLM several times for candidate formalizations of one statement, group the candidates by symbolic equivalence, and pick a group by agreement plus a learned similarity between the original text and each candidate put back into text. FormalAlign 2025 calls it alignment and fits a scoring function from labeled sentence and formula pairs. ReForm 2026 calls it semantic fidelity and trains a model that flags and rewrites its own errors. Wang et al. 2026 are the first to use the word faithfulness, in a human study of LLM autoformalizers on legal text. All four estimate faithfulness: a learned score, a vote among samples, or a human rating." & return & "Our row differs in who decides. We take one given formalization, translate it back to text and formalize that text again, and an SMT solver decides whether the two formulas are equivalent. No sampling, no learned score, no labeled data, no human in the loop. The details come in the next section. Li et al. also use a prover, but among sibling candidates of the same statement, and their final pick blends in a learned similarity." & return & "What the solver decides is equivalence, not faithfulness. Whether equivalence is a good proxy for faithfulness is the caveat a few slides from now, and later we test it against an independent measure. The second difference, localizing a failure to one translation stage, comes with the method.")
set diag to diag & "slide 3 image " & (my fitImage(s, img2, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Section", "Roundtrip verification", "", "", "Part one: the roundtrip check.")
set s to my addSlide(doc, "Title Only", "Formalize twice, then compare", "If every stage keeps the meaning, the two formulas are equivalent", "", "Here is the idea. Each of the three stages is a separate call to the LLM, so they can disagree. Start with the text x. Stage T1 formalizes it into y orig. Stage T2 puts that formula back into natural language, giving x prime. Stage T3 formalizes x prime again, giving y rt. Now compare y orig and y rt. We formalize a second time rather than compare x and x prime directly because two formulas can be handed to a solver and two sentences cannot." & return & "If every stage preserves meaning, the two formulas agree. So when they disagree, some stage lost or added meaning, and we know it without any ground truth formalization. Faithful for a stage means its output says what its input says." & return & "Agreement is not a guarantee, and I will come back to that. The expectation, which we test later, is that a wrong formula rarely survives being put into words and formalized again unchanged, so disagreement is a useful alarm.")
set diag to diag & "slide 5 image " & (my fitImage(s, img11, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Title Only", "Three LLM calls, one solver query", "UNSAT means equivalent, SAT gives a counterexample", "", "Formally, X is the set of natural-language strings and Y Sigma the well-formed formulas of the target formalism Sigma. T1 and T3 have the same type. T3 is a fresh call, and we keep it as a separate stage so a failure can be blamed on a stage. All three are LLM calls, so none of them is trusted on its own." & return & "y orig is the first formalization, y rt the one that comes back from the roundtrip. The question is whether they are equivalent. In our instance that is one satisfiability query on the negated biconditional, and the two lines in the grey box are literally what we send to Z3 after the schema declarations, that is, the sort and predicate declarations for the domain, like the ones you will see on the experiments slide. UNSAT means the two formulas are equivalent. SAT gives a counterexample, a model that distinguishes them." & return & "Three LLM calls, one solver query, and only the solver's answer comes with a guarantee. That guarantee is about equivalence. What equivalence says about faithfulness is the next slide. The framework itself needs only well-formedness and an equivalence relation on Sigma. First-order logic here, and Lean would be an equally valid target.")
set diag to diag & "slide 6 image " & (my fitImage(s, img7, 95, 285, 1730, 740)) & linefeed
set s to my addSlide(doc, "Statement", "", "", "Roundtrip equivalence is a proxy for faithfulness. Evidence, not proof.", "Two outcomes on the last slide. Take UNSAT first. The solver says the two formulas are equivalent. That is evidence of faithfulness, not a proof. Equivalence is necessary for faithfulness, as long as two faithful formulas are always equivalent under the solver's relation, and it is never sufficient. If T1 and T3 make the same mistake, say both drop the same clause, the two formulas agree on something wrong. I come back to both sides at the end." & return & "This is the proxy for faithfulness the talk is about, and later we test how good the evidence is against an independent measure of meaning.")
set s to my addSlide(doc, "Section", "Diagnosis and scoped repair", "", "", "Now the other outcome. When the solver says SAT, some stage lost or added meaning, and part two is what to do about it.")
set s to my addSlide(doc, "Title Only", "Disagreement points at a stage", "Name the first failed stage, repair only that stage", "", "Same colors as before: blue boxes hold natural language, orange boxes hold formulas. Stage i is T i. When the solver says SAT, an LLM judge, D, reads the four artifacts: x, y orig, x prime, y rt. It does not get the solver's counterexample, only the SAT verdict triggers it. It examines the stages in order: x against y orig, then y orig against x prime, then x prime against y rt. It halts at the first inconsistency and writes an explanation that mentions only that stage's two artifacts. The judge never accepts anything. Acceptance is still the solver's UNSAT. Done in the green box means the loop stops. The caveat from two slides ago still stands. The judge only picks which stage to redo, so a wrong diagnosis wastes a round but cannot make a wrong formula pass." & return & "The repair operator R i then rewrites only that stage from its two artifacts and the explanation. Everything downstream is rerun and the solver checks again." & return & "Keep this examine-in-order protocol in mind. It comes back in the results.")
set diag to diag & "slide 9 image " & (my fitImage(s, img9, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Title Only", "At most three rounds of repair", "Stop at equivalence, or give up after K = 3", "", "Here is the whole loop as pseudocode. At most K rounds of check, diagnose, repair, rerun downstream. It returns SUCCESS with the equivalent pair, or FAILURE with the last artifacts once the budget is spent." & return & "K is 3 in all experiments because the gains flatten quickly. K counts rounds. Each round starts with a check and ends with a repair, so the pseudocode runs K checks and up to K repairs, and after the K-th repair it returns FAILURE with the latest artifacts. Each T i and R i is a single stateless LLM call. The domain schema, the list of predicates the model may use, goes into the prompt, which is the fixed instruction text handed to the LLM. D is one call as well. Nothing is carried between calls.")
set diag to diag & "slide 10 image " & (my fitImage(s, img0, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Section", "Experiments", "", "", "Part three: does this work in practice?")
set s to my addSlide(doc, "Title, Bullets & Photo", "No ground truth", "Two domains, two LLMs", "Traffic: 150 rules, Texas Transportation Code" & return & "Wildlife: 77 rules, Texas Parks and Wildlife Code" & return & "Many-sorted FOL over a curated schema, about 200 predicates" & return & "Claude Opus 4.6 and GPT-5.2, same prompts. Z3 under 1 s per check", "Two statutory domains. Traffic: 150 rules from the Texas Transportation Code, lane positioning, passing, speed limits. Wildlife: 77 rules from the Texas Parks and Wildlife Code, licensing, seasons, bag limits. A rule is one statutory provision, formalized on its own. There is no reference formalization of these statutes to compare against, which is exactly the setting the roundtrip check is for." & return & "The target is many-sorted first-order logic over a curated domain schema, about 200 predicates per domain. On the right is an excerpt of the traffic schema." & return & "Two commercial LLMs from different vendors, Claude Opus 4.6 from Anthropic and GPT-5.2 from OpenAI, each given the same fixed instruction text, which is what a prompt is. Z3 decides every check in under a second. The queries are quantified, and the handful that came back unknown or errored, seven across all runs, are counted as not equivalent." & return & "Two domains times two LLMs gives the four domain-model pairs you will see.")
my clearImages(s)
set diag to diag & "slide 12 image " & (my fitImage(s, img3, 1000, 140, 825, 800)) & linefeed
set s to my addSlide(doc, "Title & Bullets", "Three baselines, two design choices", "Random tests diagnosis. Regenerate tests scoping.", "No repair: the first pass is final" & return & "Random stage: same loop, stage picked uniformly at random, no diagnosis" & return & "Regenerate: redo the whole pipeline from x, no diagnosis" & return & "Scoped: diagnose the first failed stage, repair only that stage", "Four conditions. No repair: the first pass is final. Random stage: the same loop, but the stage to repair is picked uniformly at random. That tests whether diagnosis matters. Regenerate: redo the whole pipeline from x. That tests whether scoping matters. Scoped, called Full in the paper: diagnose the first failed stage and repair only that stage. All four share the same first pass and K equals 3." & return & "Two metrics from here on. Equivalence rate is the share of rules whose final check is UNSAT. Cost is LLM calls spent on repair divided by the number of rules repair brought to equivalence. Equivalence rate is the proxy, not faithfulness itself. Whether a higher rate tracks faithfulness is what we test at the end of this section against an independent measure of meaning.")
set s to my addSlide(doc, "Title Only", "Scoped repair wins only with Claude", "One LLM formalizes, judges, and repairs", "", "In this table one LLM does everything. It formalizes, judges, and repairs. Each row is one domain and one LLM." & return & "With Claude, scoped repair reaches the highest equivalence rate at the lowest cost on both domains. With GPT, Regenerate beats scoped repair, and scoped repair is the most expensive method. So the method depends on the model. Why?")
set diag to diag & "slide 14 image " & (my fitImage(s, img5, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Big Fact", "", "of GPT's diagnoses blame stage 1 (Traffic and Wildlife)", "83% and 97%", "Because of the judge. 83 percent of GPT's diagnoses on Traffic and 97 percent on Wildlife blame stage 1. A stage 1 repair reruns everything downstream, so scoped repair degenerates into Regenerate plus a judge call. That is the cost gap you just saw. The rate gap is smaller than the cost gap, and the judge swap on the next slide puts scoped repair back in front." & return & "Is this the data or the judge? We re-judged the same GPT artifacts with a prompt that drops the examine-in-order instruction. Stage 1 blame drops to 9 percent on Traffic and 16 percent on Wildlife. The skew comes from the judge protocol, not from the data. So the protocol interacts badly with GPT as the judge. We keep the protocol anyway, because the examine-in-order instruction is what defines the first failed stage, and scoped repair needs that stage. The non-sequential prompt was tested only as a re-diagnosis of the existing failures, not as a full repair run. So next we keep the protocol and change only the model that runs it.")
set s to my addSlide(doc, "Title Only", "Swap the judge, keep everything else", "Claude judges, GPT still formalizes and repairs", "", "So we swap only the judge. Claude diagnoses, GPT still writes and repairs every formula. No repair, Random, and Regenerate use no judge, so their numbers do not change and are shown once, on the GPT row. Red marks where scoped repair fell behind Regenerate, green where the judge swap puts it back in front." & return & "Equivalence rises from 82.7 to 90.7 percent on Traffic and from 78.9 to 94.7 on Wildlife. Cost per repaired rule falls from 14.6 to 7.9 calls and from 26.4 to 6.1, below every other repair method." & return & "The judge was the bottleneck, not the pipeline and not the repair operators.")
set diag to diag & "slide 16 image " & (my fitImage(s, img4, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Title, Bullets & Photo", "Does x' match x?", "Outside the repair loop", "NLI scores entailment (E) and contradiction (C)" & return & "E→ is x to x', E← is x' to x" & return & "E min and C max: the worse of the two directions" & return & "Drift: shaded leaves, x' says something else", "Back to the caveat on the statement slide. Agreement is evidence, not proof. To test how good the evidence is we need a measure of meaning preserved between x and x prime that never touches the solver. Why that pair: x prime is y orig put into words, so if y orig lost or added meaning, x prime should differ from x. On the roundtrip slide I said two sentences cannot go to a solver. They can go to a text classifier." & return & "Natural language inference, NLI, is a learned classifier that, given two sentences, scores how likely one entails or contradicts the other. We use a publicly available classifier trained on a standard corpus of sentence pairs, the exact model is in the paper. We run it both ways between x and x prime, because entailment in one direction alone would let the reconstruction drop content or add content unnoticed. The drift measure on the next slide uses only the two leaves that do not depend on direction. The two middle leaves, Strengthened and Weakened, are not used for drift, so skip them. The leaf called Equivalent here is the classifier's label for the sentence pair, not the solver's verdict. The solver never sees sentences." & return & "The tree on the right turns the scores into six categories. E min is the smaller of the two entailment scores and C max the larger of the two contradiction scores, so each takes the worse direction. Drift means x prime says something different from x, the Unrelated and Contradiction leaves. The thresholds are fixed conservative cutoffs, identical across both domains and both models, and the repair loop never sees any of this." & return & "This is post-hoc only.")
my clearImages(s)
set diag to diag & "slide 17 image " & (my fitImage(s, img10, 1000, 140, 825, 800)) & linefeed
set s to my addSlide(doc, "Title Only", "Failing rules drift twice as much", "Failing means still SAT after scoped repair", "", "Here failing means still SAT after scoped repair, with the same-model judge throughout, the runs from the first results table. On all four domain-model pairs, failing rules drift more often than passing rules, 1.4 to 2.5 times, 2.0 pooled, and the gap is already there before any repair runs." & return & "So the check carries real signal about faithfulness. Drift is itself a proxy, so we also ran a blind human check on 25 rules. 13 of 14 passing formalizations were judged faithful, against 8 of 11 failing ones. So many failing rules are still faithful. That is the false-reject side, which I come to in the limits." & return & "That is the claim from the statement slide, now with evidence.")
set diag to diag & "slide 18 image " & (my fitImage(s, img8, 95, 280, 1730, 750)) & linefeed
set s to my addSlide(doc, "Section", "Limits and what comes next", "", "", "Part four: where the method stops, and what comes next.")
set s to my addSlide(doc, "Title & Bullets", "Rule structure is what resists repair", "26 of 227 rules resist every method and both LLMs", "Schema vocabulary gaps: no predicate fits, T1 and T3 pick different substitutes" & return & "Compound conditions: nested AND/OR formalized two ways" & return & "Exception clauses: T2 restates the exception positively, T3 formalizes the inverse" & return & "Conditional thresholds: a bound that depends on another variable gets dropped", "26 of the 227 rules stay non-equivalent under every method and both LLMs. Four patterns." & return & "Schema vocabulary gaps: no predicate fits, so T1 and T3 pick different substitutes. Compound conditions: nested AND and OR formalized two ways. Exception clauses: T2 restates the exception positively and T3 formalizes the inverse. Conditional thresholds: a bound that depends on another variable gets dropped." & return & "The residual bottleneck is rule structure, not the iteration budget. Earlier the bottleneck was the judge, and that one we could fix.")
set s to my addSlide(doc, "Title, Bullets & Photo", "A proxy can fail", "Where the proxy goes wrong", "False accept: T1 and T3 share a mistake and agree on a wrong formula" & return & "False reject: faithful formulas that no check relates", "Where the proxy fails. Two directions." & return & "False accepts: T1 and T3 share a mistake and agree on a wrong formula." & return & "False rejects: one sentence can have several faithful formulas. The Lean example on the right: n is a positive integer, encoded over the natural numbers or over the integers. Both are faithful. They live at different types, so no equivalence check relates them, and a roundtrip that lands on one of each reports a disagreement.")
my clearImages(s)
set diag to diag & "slide 21 image " & (my fitImage(s, img1, 1000, 140, 825, 800)) & linefeed
set s to my addSlide(doc, "Title & Bullets", "Our evidence stops at Texas law", "One kind of text, one rule at a time, one noisy check", "Texas law in English only. No claim for programs or scientific text" & return & "Each rule is formalized alone, although rules cross-reference each other heavily" & return & "The NLI check is itself noisy: a general-purpose model with known lexical biases on legal text", "Three limits from the paper. First, both corpora are English statutory text from Texas. Statutes are where a ground-truth-free check is most needed, because a schema of 200 predicates makes hand verification at scale impractical, but we do not claim the framework transfers to code or scientific text without further evaluation." & return & "Second, each rule is formalized on its own. Statutes cross-reference heavily: a rule may import definitions from another section or suspend an obligation stated elsewhere. Faithful formalization of such clusters likely needs the connected rules presented together." & return & "Third, the NLI check that anchors the drift results is itself a general-purpose model with known lexical-overlap biases on legal text, that is, it tends to score two sentences as entailing each other when they share many words, whatever they mean, so its signal is noisy. It is a partial mitigation, not a second oracle.")
set s to my addSlide(doc, "Title & Bullets", "A reward with no ground truth", "Roundtrip equivalence as a post-training signal", "Post-training: train an LLM further to maximize a numeric score, the reward" & return & "Roundtrip equivalence can be that score, and it needs no ground truth", "What comes next. Post-training means training an LLM further to maximize a numeric score, called a reward. For faithful autoformalization we need a faithfulness score, and roundtrip equivalence is one that needs no ground truth, so it is a natural reward. The false-accept case from two slides ago is what such a reward would have to guard against: a model must not learn to make T1 and T3 agree without being faithful." & return & "Two smaller directions: bring NLI or an LLM check into the repair loop rather than using it only after the fact, and formalize clusters of cross-referenced rules together instead of one rule at a time.")
set s to my addSlide(doc, "Title", "Roundtrip equivalence is a proxy for faithfulness with no ground truth", "Daneshvar Amrollahi, Stanford University", "Findings of EMNLP 2026" & return & "Code, data, prompts, schemas:" & return & "github.com/daneshvar-amrollahi/roundtrip-autoformalization" & return & "" & return & "daneshvar@cs.stanford.edu  ·  cs.stanford.edu/~daneshva", "To close: roundtrip equivalence is a proxy for faithfulness that needs no ground truth. Code, data, prompts, and schemas are public. Thank you.")
tell application "Keynote"
	save doc
	export doc to outFolder as slide images with properties {image format:PNG, skipped slides:false}
	set diag to diag & "slides: " & (count of slides of doc)
end tell
return diag
